# Service account the bot posts as (copy these from its JSON key)
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"

# Space the daily thought is posted to
GOOGLE_CHAT_SPACE_ID=spaces/your-space-id

# Number (not ID) of the Cloud project hosting the Chat app
GOOGLE_PROJECT_NUMBER=123456789012

# Exactly the "HTTP endpoint URL" from the Chat app configuration; used to verify webhook requests
CHAT_ENDPOINT_URL=https://your-domain/webhook

# Optional
# TIMEZONE=Europe/London
# PORT=3000

# Cloud Scheduler: set both to enable POST /tasks/daily
# TASK_AUDIENCE=https://your-service-url/tasks/daily
# TASK_INVOKER_EMAIL=inspiration-scheduler@your-project.iam.gserviceaccount.com

# Or schedule inside the app (only for hosts that keep it running)
# CRON_SCHEDULE=*/30 6-12 * * *
